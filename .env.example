# Copy this file to ".env" and fill in your own values. Never commit .env to GitHub.
PORT=3000
# MongoDB Atlas connection string - the database name "Giftify" goes before the "?"
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Giftify?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
# Admin account created by "npm run seed" (change these before seeding)
ADMIN_NAME=Giftify Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@giftify.com
ADMIN_PASSWORD=Admin@123
